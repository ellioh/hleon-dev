# Base de datos MySQL (packages/db)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=hleon_dev
DB_SSL=true

# Auth del backoffice (packages/auth) - reemplaza ADMIN_TOKEN_SECRET/ADMIN_PASSWORD.
# SESSION_SECRET no tiene valor por defecto: sin él, el login no puede emitir sesiones.
SESSION_SECRET=
ADMIN_PASSWORD_HASH=

# API pública de Laravel (backend/laravel) - consumida por app/portafolio.
# En local: http://localhost:8123. En producción: la URL pública del API una
# vez desplegado (ver docker/ + VPS, todavía pendiente).
LARAVEL_API_URL=http://localhost:8123
