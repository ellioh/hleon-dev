# Valores de producción que difieren de backend/laravel/.env.example.
# Partir de ese archivo (cp .env.example .env), aplicar estos cambios y
# luego `php artisan key:generate`.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.hleon.dev
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hleon_dev
DB_USERNAME=hleon
DB_PASSWORD=

# Cookies compartidas entre api.hleon.dev y el panel en hleon.dev/panel
SESSION_DOMAIN=.hleon.dev
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=hleon.dev
CORS_ALLOWED_ORIGINS=https://hleon.dev

# Cuenta única de administrador (la crea el seeder)
ADMIN_NOMBRE="Heli León"
ADMIN_EMAIL=h.leon@pucp.pe
ADMIN_PASSWORD=
