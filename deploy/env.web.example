# Copiar a /var/www/hleon.dev/.env.production.local (ignorado por git).
# Debe existir ANTES de `npm run build`: next.config.ts lee LARAVEL_API_URL
# en build para autorizar las imágenes de /storage.
NEXT_PUBLIC_SITE_URL=https://hleon.dev
LARAVEL_API_URL=https://api.hleon.dev

# Admin legado basado en JSON (/admin del sitio Next.js)
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
